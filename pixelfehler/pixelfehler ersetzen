import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.ndimage import median_filter

# --------------------------------------------------
# Settings
# --------------------------------------------------
input_file = r"C:\Users\User\Desktop\combined INT front csv\average_INT front bg substracted.csv"
output_file = r"C:\Users\User\Desktop\combined INT front csv\average_INT front bg substract_corrected.csv"

# Einzelbilder
original_img_file = r"C:\Users\User\Desktop\combined INT front csv\original.png"
bad_pixels_img_file = r"C:\Users\User\Desktop\combined INT front csv\bad_pixels.png"
corrected_img_file = r"C:\Users\User\Desktop\combined INT front csv\corrected.png"

# Gesamt-PDF
pdf_file = r"C:\Users\User\Desktop\combined INT front csv\result.pdf"

# Size of the local neighborhood
filter_size = 10

# Threshold: how much a pixel must deviate from its surroundings
threshold = 5.0

# Optional: only correct inside the sample region
use_mask = True
mask_threshold = 0
# --------------------------------------------------

# Load image from CSV
img = pd.read_csv(input_file, header=None).values.astype(float)

# Mask for valid region
if use_mask:
    mask = img > mask_threshold
else:
    mask = np.ones_like(img, dtype=bool)

# Compute local median
local_median = median_filter(img, size=filter_size)

# Absolute deviation from local neighborhood
abs_diff = np.abs(img - local_median)

# Estimate typical local variation (robust)
local_dev = median_filter(abs_diff, size=filter_size)

# Avoid division by zero
eps = 1e-6

# Detect hot/dead pixels
bad_pixels = mask & (abs_diff > threshold * (local_dev + eps))

# Create corrected image
corrected = img.copy()
corrected[bad_pixels] = local_median[bad_pixels]

# Save corrected CSV
pd.DataFrame(corrected).to_csv(output_file, header=False, index=False)

print(f"Corrected file saved: {output_file}")
print(f"Number of corrected pixels: {bad_pixels.sum()}")

# --------------------------------------------------
# 1) Gesamtfigur als PDF
# --------------------------------------------------
fig, ax = plt.subplots(1, 3, figsize=(15, 5))

ax[0].imshow(img, cmap="viridis")
ax[0].set_title("Original")
ax[0].axis("off")

ax[1].imshow(bad_pixels, cmap="hot")
ax[1].set_title("Detected bad pixels")
ax[1].axis("off")

ax[2].imshow(corrected, cmap="viridis")
ax[2].set_title("Corrected")
ax[2].axis("off")

plt.tight_layout()
plt.savefig(pdf_file, dpi=300, bbox_inches="tight")
plt.show()
plt.close()

# --------------------------------------------------
# 2) Drei einzelne Bilder speichern
# --------------------------------------------------

# Original
plt.figure(figsize=(5, 5))
plt.imshow(img, cmap="viridis")
plt.title("Original")
plt.axis("off")
plt.tight_layout()
plt.savefig(original_img_file, dpi=300, bbox_inches="tight")
plt.close()

# Bad pixels
plt.figure(figsize=(5, 5))
plt.imshow(bad_pixels, cmap="hot")
plt.title("Detected bad pixels")
plt.axis("off")
plt.tight_layout()
plt.savefig(bad_pixels_img_file, dpi=300, bbox_inches="tight")
plt.close()

# Corrected
plt.figure(figsize=(5, 5))
plt.imshow(corrected, cmap="viridis")
plt.title("Corrected")
plt.axis("off")
plt.tight_layout()
plt.savefig(corrected_img_file, dpi=300, bbox_inches="tight")
plt.close()

print("Saved individual images:")
print(original_img_file)
print(bad_pixels_img_file)
print(corrected_img_file)