INPUT_FOLDER = Path(r"C:\Users\User\Desktop\Lens beam size plot")
OUTPUT_FOLDER = INPUT_FOLDER / "gaussfit_plots"

# Falls bekannt, Pixelgröße in µm/Pixel eintragen.
# Wenn None, bleiben Achsen in Pixeln.
PIXEL_SIZE_UM: float | None = None

# Hintergrundabzug über Perzentil
BACKGROUND_PERCENTILE = 8.0

# Fit nur oberhalb dieses relativen Pegels
FIT_THRESHOLD_REL = 0.05

# Negativen Offset im Fit erlauben?
ALLOW_NEGATIVE_OFFSET = False

# Plot speichern als
SAVE_PNG = True
SAVE_SVG = True
DPI = 220

# Colormap
CMAP = "inferno"


# ============================================================
# HILFSFUNKTIONEN
# ============================================================

def ensure_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)


def load_tiff(path: Path) -> np.ndarray:
    img = Image.open(path)
    arr = np.array(img, dtype=np.float64)

    # Falls RGB/BGR etc.: in Graustufen umwandeln
    if arr.ndim == 3:
        arr = arr.mean(axis=2)

    if arr.ndim != 2:
        raise ValueError(f"{path.name}: Erwartet 2D-Bild, bekommen: shape={arr.shape}")

    return arr


def subtract_background(img: np.ndarray, percentile: float = BACKGROUND_PERCENTILE) -> np.ndarray:
    bg = float(np.percentile(img, percentile))
    out = img.astype(np.float64) - bg
    out[out < 0] = 0.0
    return out


def weighted_centroid(img: np.ndarray) -> tuple[float, float]:
    total = float(img.sum())
    if total <= 0:
        raise ValueError("Bild enthält nach Hintergrundabzug kein positives Signal.")

    y, x = np.indices(img.shape)
    cx = float((img * x).sum() / total)
    cy = float((img * y).sum() / total)
    return cx, cy


def second_moments(img: np.ndarray) -> tuple[float, float, float]:
    """
    Liefert sigma_x, sigma_y und das gemischte Moment cov_xy.
    """
    total = float(img.sum())
    if total <= 0:
        raise ValueError("Bild enthält kein positives Signal.")

    y, x = np.indices(img.shape)
    cx, cy = weighted_centroid(img)

    dx = x - cx
    dy = y - cy

    var_x = float((img * dx**2).sum() / total)
    var_y = float((img * dy**2).sum() / total)
    cov_xy = float((img * dx * dy).sum() / total)

    sigma_x = math.sqrt(max(var_x, 1e-15))
    sigma_y = math.sqrt(max(var_y, 1e-15))
    return sigma_x, sigma_y, cov_xy


def sanitize_filename(name: str) -> str:
    return "".join(c if c.isalnum() or c in "._-" else "_" for c in name)


def extract_position_cm_from_filename(path: Path) -> float:
    """
    Extrahiert die Position in cm aus dem Dateinamen.

    Beispiele:
        350.tiff      -> 350.0
        350cm.tiff    -> 350.0
        pos_350cm.tif -> 350.0
        z=350.5cm.tif -> 350.5
    """
    stem = path.stem.strip()

    # Erst nach explizitem "...cm" suchen
    matches_cm = re.findall(r"([-+]?\d+(?:[.,]\d+)?)\s*cm", stem, flags=re.IGNORECASE)
    if matches_cm:
        return float(matches_cm[-1].replace(",", "."))

    # Sonst letzte Zahl im Dateinamen nehmen
    matches_num = re.findall(r"[-+]?\d+(?:[.,]\d+)?", stem)
    if matches_num:
        return float(matches_num[-1].replace(",", "."))

    raise ValueError(f"Keine Positionsangabe im Dateinamen gefunden: {path.name}")


# ============================================================
# ROTIERTER 2D-GAUSS-FIT
# ============================================================

def gaussian_2d_rotated(
    xy: tuple[np.ndarray, np.ndarray],
    amplitude: float,
    x0: float,
    y0: float,
    sigma_x: float,
    sigma_y: float,
    theta: float,
    offset: float,
) -> np.ndarray:
    """
    Rotierter 2D-Gauß:
    I(x,y) = offset + A * exp( -(a*(x-x0)^2 + 2b(x-x0)(y-y0) + c*(y-y0)^2) )
    """
    x, y = xy
    sigma_x = max(float(sigma_x), 1e-9)
    sigma_y = max(float(sigma_y), 1e-9)

    ct = math.cos(theta)
    st = math.sin(theta)

    a = (ct**2) / (2.0 * sigma_x**2) + (st**2) / (2.0 * sigma_y**2)
    b = (-math.sin(2.0 * theta)) / (4.0 * sigma_x**2) + (math.sin(2.0 * theta)) / (4.0 * sigma_y**2)
    c = (st**2) / (2.0 * sigma_x**2) + (ct**2) / (2.0 * sigma_y**2)

    g = offset + amplitude * np.exp(
        -(a * (x - x0) ** 2 + 2.0 * b * (x - x0) * (y - y0) + c * (y - y0) ** 2)
    )
    return g.ravel()


def initial_guess_from_moments(img: np.ndarray) -> list[float]:
    ny, nx = img.shape
    cx, cy = weighted_centroid(img)
    sigma_x, sigma_y, cov_xy = second_moments(img)

    cov = np.array([
        [sigma_x**2, cov_xy],
        [cov_xy, sigma_y**2]
    ], dtype=float)

    eigvals, eigvecs = np.linalg.eigh(cov)
    order = np.argsort(eigvals)[::-1]
    eigvals = eigvals[order]
    eigvecs = eigvecs[:, order]

    sigma_major = math.sqrt(max(eigvals[0], 1e-12))
    sigma_minor = math.sqrt(max(eigvals[1], 1e-12))
    theta = math.atan2(eigvecs[1, 0], eigvecs[0, 0])

    offset0 = float(np.percentile(img, 5))
    amplitude0 = float(np.max(img) - offset0)
    amplitude0 = max(amplitude0, 1.0)

    sigma_major = min(max(sigma_major, 1.0), max(nx, ny))
    sigma_minor = min(max(sigma_minor, 1.0), max(nx, ny))

    return [amplitude0, cx, cy, sigma_major, sigma_minor, theta, offset0]


def fit_gaussian_2d(img: np.ndarray) -> tuple[dict[str, float], np.ndarray]:
    if np.max(img) <= 0:
        raise ValueError("Kein positives Signal für den Fit vorhanden.")

    ny, nx = img.shape
    y, x = np.indices(img.shape)

    threshold = FIT_THRESHOLD_REL * float(np.max(img))
    fit_mask = img >= threshold
    if np.count_nonzero(fit_mask) < 30:
        fit_mask = np.ones_like(img, dtype=bool)

    x_fit = x[fit_mask].astype(float)
    y_fit = y[fit_mask].astype(float)
    z_fit = img[fit_mask].astype(float)

    p0 = initial_guess_from_moments(img)

    lower_offset = -np.inf if ALLOW_NEGATIVE_OFFSET else 0.0
    lower_bounds = np.array([0.0, 0.0, 0.0, 0.2, 0.2, -np.pi / 2.0, lower_offset], dtype=float)
    upper_bounds = np.array([np.inf, nx - 1.0, ny - 1.0, max(nx, ny), max(nx, ny), np.pi / 2.0, np.inf], dtype=float)

    p0 = np.asarray(p0, dtype=float)

    eps = np.array([1e-12, 1e-6, 1e-6, 1e-6, 1e-6, 1e-6, 1e-12], dtype=float)

    for i in range(len(p0)):
        lo = lower_bounds[i]
        hi = upper_bounds[i]

        if np.isfinite(lo) and p0[i] < lo:
            p0[i] = lo + eps[i]
        if np.isfinite(hi) and p0[i] > hi:
            p0[i] = hi - eps[i]

    popt, _ = curve_fit(
        gaussian_2d_rotated,
        (x_fit, y_fit),
        z_fit.ravel(),
        p0=p0,
        bounds=(lower_bounds, upper_bounds),
        maxfev=50000,
    )

    amplitude, x0, y0, sigma_x, sigma_y, theta, offset = [float(v) for v in popt]

    fit_img = gaussian_2d_rotated(
        (x.astype(float), y.astype(float)),
        amplitude, x0, y0, sigma_x, sigma_y, theta, offset
    ).reshape(img.shape)

    params = {
        "amplitude": amplitude,
        "x0_px": x0,
        "y0_px": y0,
        "sigma_x_px": sigma_x,
        "sigma_y_px": sigma_y,
        "theta_rad": theta,
        "theta_deg": math.degrees(theta),
        "offset": offset,
    }
    return params, fit_img


# ============================================================
# PROFILE / KENNGRÖSSEN
# ============================================================

def fwhm_from_sigma(sigma: float) -> float:
    return 2.0 * math.sqrt(2.0 * math.log(2.0)) * sigma


def unit_label() -> str:
    return "mm" if PIXEL_SIZE_UM is not None else "px"


def scale_axis(values_px: np.ndarray) -> np.ndarray:
    if PIXEL_SIZE_UM is None:
        return values_px
    return values_px * PIXEL_SIZE_UM / 1000.0


def scale_value(value_px: float) -> float:
    if PIXEL_SIZE_UM is None:
        return value_px
    return value_px * PIXEL_SIZE_UM / 1000.0


def extract_center_profiles(img: np.ndarray, x0: float, y0: float) -> tuple[np.ndarray, np.ndarray, int, int]:
    x_idx = int(np.clip(round(x0), 0, img.shape[1] - 1))
    y_idx = int(np.clip(round(y0), 0, img.shape[0] - 1))

    profile_x = img[y_idx, :]
    profile_y = img[:, x_idx]
    return profile_x, profile_y, x_idx, y_idx


def r_squared(y_true: np.ndarray, y_fit: np.ndarray) -> float:
    y_true = np.asarray(y_true, dtype=float)
    y_fit = np.asarray(y_fit, dtype=float)
    ss_res = float(np.sum((y_true - y_fit) ** 2))
    ss_tot = float(np.sum((y_true - np.mean(y_true)) ** 2))
    if ss_tot <= 0:
        return np.nan
    return 1.0 - ss_res / ss_tot


# ============================================================
# PLOTTEN
# ============================================================

def make_publication_plot(img_raw: np.ndarray, img_fit: np.ndarray, fit: dict[str, float], input_path: Path, outdir: Path) -> None:
    x0 = fit["x0_px"]
    y0 = fit["y0_px"]
    sigma_x = fit["sigma_x_px"]
    sigma_y = fit["sigma_y_px"]
    theta_deg = fit["theta_deg"]

    profile_x_raw, profile_y_raw, x_idx, y_idx = extract_center_profiles(img_raw, x0, y0)
    profile_x_fit, profile_y_fit, _, _ = extract_center_profiles(img_fit, x0, y0)

    x_axis_px = np.arange(img_raw.shape[1], dtype=float)
    y_axis_px = np.arange(img_raw.shape[0], dtype=float)

    x_axis_plot = scale_axis(x_axis_px)
    y_axis_plot = scale_axis(y_axis_px)

    unit = unit_label()

    d_1e2_x = 4.0 * sigma_x
    d_1e2_y = 4.0 * sigma_y
    fwhm_x = fwhm_from_sigma(sigma_x)
    fwhm_y = fwhm_from_sigma(sigma_y)

    d_1e2_x_plot = scale_value(d_1e2_x)
    d_1e2_y_plot = scale_value(d_1e2_y)
    fwhm_x_plot = scale_value(fwhm_x)
    fwhm_y_plot = scale_value(fwhm_y)

    r2_x = r_squared(profile_x_raw, profile_x_fit)
    r2_y = r_squared(profile_y_raw, profile_y_fit)

    fig = plt.figure(figsize=(13, 8))
    gs = fig.add_gridspec(2, 2, width_ratios=[1.1, 1.0], height_ratios=[1.0, 1.0], wspace=0.28, hspace=0.30)

    ax0 = fig.add_subplot(gs[:, 0])

    extent = None
    if PIXEL_SIZE_UM is not None:
        extent = [
            scale_value(0),
            scale_value(img_raw.shape[1] - 1),
            scale_value(img_raw.shape[0] - 1),
            scale_value(0),
        ]

    im = ax0.imshow(img_raw, cmap=CMAP, origin="upper", extent=extent)
    cbar = fig.colorbar(im, ax=ax0, fraction=0.046, pad=0.04)
    cbar.set_label("Intensity [a.u.]")

    x0_plot = scale_value(x0)
    y0_plot = scale_value(y0)
    ax0.plot(x0_plot, y0_plot, marker="+", markersize=12, markeredgewidth=2)

    ellipse_width = scale_value(4.0 * sigma_x)
    ellipse_height = scale_value(4.0 * sigma_y)

    ell = Ellipse(
        xy=(x0_plot, y0_plot),
        width=ellipse_width,
        height=ellipse_height,
        angle=theta_deg,
        fill=False,
        linewidth=2.2,
    )
    ax0.add_patch(ell)

    ax0.set_title("2D intensity profile with Gaussian fit")
    ax0.set_xlabel(f"x [{unit}]")
    ax0.set_ylabel(f"y [{unit}]")

    ax1 = fig.add_subplot(gs[0, 1])
    ax1.plot(x_axis_plot, profile_x_raw, linewidth=2, label="Measured profile")
    ax1.plot(x_axis_plot, profile_x_fit, "--", linewidth=2, label="Gaussian fit")
    ax1.set_title("Horizontal profile")
    ax1.set_xlabel(f"x [{unit}]")
    ax1.set_ylabel("Intensity [a.u.]")
    ax1.grid(True, alpha=0.3)
    ax1.legend()

    ax2 = fig.add_subplot(gs[1, 1])
    ax2.plot(y_axis_plot, profile_y_raw, linewidth=2, label="Measured profile")
    ax2.plot(y_axis_plot, profile_y_fit, "--", linewidth=2, label="Gaussian fit")
    ax2.set_title("Vertical profile")
    ax2.set_xlabel(f"y [{unit}]")
    ax2.set_ylabel("Intensity [a.u.]")
    ax2.grid(True, alpha=0.3)
    ax2.legend()

    text = (
        f"File: {input_path.name}\n"
        f"Center: ({x0_plot:.2f}, {y0_plot:.2f}) {unit}\n"
        f"1/e² diameter x: {d_1e2_x_plot:.2f} {unit}\n"
        f"1/e² diameter y: {d_1e2_y_plot:.2f} {unit}\n"
        f"FWHM x: {fwhm_x_plot:.2f} {unit}\n"
        f"FWHM y: {fwhm_y_plot:.2f} {unit}\n"
        f"Rotation: {theta_deg:.2f}°\n"
        f"R² (x-profile): {r2_x:.4f}\n"
        f"R² (y-profile): {r2_y:.4f}"
    )

    fig.text(
        0.64, 0.08, text,
        fontsize=10,
        bbox=dict(boxstyle="round", facecolor="white", alpha=0.9)
    )

    fig.suptitle("Gaussian fit of laser beam intensity", fontsize=15)
    fig.tight_layout(rect=[0, 0, 1, 0.97])

    stem = sanitize_filename(input_path.stem)
    if SAVE_PNG:
        fig.savefig(outdir / f"{stem}_gaussfit.png", dpi=DPI, bbox_inches="tight")
    if SAVE_SVG:
        fig.savefig(outdir / f"{stem}_gaussfit.svg", bbox_inches="tight")

    plt.close(fig)


def make_propagation_plot(results: list[dict[str, float | str]], outdir: Path) -> None:
    """
    Erstellt einen zusätzlichen Plot:
    x-Achse = Position entlang der Propagation (cm aus Dateiname)
    y-Achse = Beam size (1/e²-Durchmesser in px oder mm)
    """
    if not results:
        print("Keine gültigen Ergebnisse für Propagationsplot vorhanden.")
        return

    results_sorted = sorted(results, key=lambda r: float(r["z_cm"]))

    z_cm = np.array([float(r["z_cm"]) for r in results_sorted], dtype=float)
    d_1e2_x_px = np.array([float(r["d_1e2_x_px"]) for r in results_sorted], dtype=float)
    d_1e2_y_px = np.array([float(r["d_1e2_y_px"]) for r in results_sorted], dtype=float)

    d_1e2_x_plot = scale_axis(d_1e2_x_px)
    d_1e2_y_plot = scale_axis(d_1e2_y_px)

    unit = unit_label()

    fig, ax = plt.subplots(figsize=(10, 6))
    ax.plot(z_cm, d_1e2_x_plot, "o-", linewidth=2, markersize=6, label="1/e² diameter x")
    ax.plot(z_cm, d_1e2_y_plot, "s-", linewidth=2, markersize=6, label="1/e² diameter y")

    ax.set_title("Beam size vs propagation position")
    ax.set_xlabel("Beam position / propagation direction [cm]")
    ax.set_ylabel(f"Beam size [{unit}]")
    ax.grid(True, alpha=0.3)
    ax.legend()

    fig.tight_layout()

    if SAVE_PNG:
        fig.savefig(outdir / "beam_propagation.png", dpi=DPI, bbox_inches="tight")
    if SAVE_SVG:
        fig.savefig(outdir / "beam_propagation.svg", bbox_inches="tight")

    plt.close(fig)


# ============================================================
# MAIN
# ============================================================

def main() -> None:
    ensure_dir(OUTPUT_FOLDER)

    files = sorted(list(INPUT_FOLDER.glob("*.tif")) + list(INPUT_FOLDER.glob("*.tiff")))
    if not files:
        raise SystemExit(f"Keine TIFF-Dateien gefunden in: {INPUT_FOLDER}")

    print(f"Gefundene TIFF-Dateien: {len(files)}")
    print(f"Ausgabeordner: {OUTPUT_FOLDER}")

    propagation_results: list[dict[str, float | str]] = []

    for path in files:
        try:
            img = load_tiff(path)
            img_bg = subtract_background(img)
            fit_params, fit_img = fit_gaussian_2d(img_bg)
            make_publication_plot(img_bg, fit_img, fit_params, path, OUTPUT_FOLDER)

            z_cm = extract_position_cm_from_filename(path)

            d_1e2_x_px = 4.0 * fit_params["sigma_x_px"]
            d_1e2_y_px = 4.0 * fit_params["sigma_y_px"]
            fwhm_x_px = fwhm_from_sigma(fit_params["sigma_x_px"])
            fwhm_y_px = fwhm_from_sigma(fit_params["sigma_y_px"])

            propagation_results.append({
                "file": path.name,
                "z_cm": z_cm,
                "x0_px": fit_params["x0_px"],
                "y0_px": fit_params["y0_px"],
                "sigma_x_px": fit_params["sigma_x_px"],
                "sigma_y_px": fit_params["sigma_y_px"],
                "d_1e2_x_px": d_1e2_x_px,
                "d_1e2_y_px": d_1e2_y_px,
                "fwhm_x_px": fwhm_x_px,
                "fwhm_y_px": fwhm_y_px,
                "theta_deg": fit_params["theta_deg"],
            })

            print(
                f"OK: {path.name} | "
                f"z={z_cm:.2f} cm, "
                f"x0={fit_params['x0_px']:.2f}px, y0={fit_params['y0_px']:.2f}px, "
                f"sx={fit_params['sigma_x_px']:.2f}px, sy={fit_params['sigma_y_px']:.2f}px, "
                f"theta={fit_params['theta_deg']:.2f}°"
            )

        except Exception as exc:
            print(f"FEHLER bei {path.name}: {exc}")

    make_propagation_plot(propagation_results, OUTPUT_FOLDER)

    print("\nFertig.")


if __name__ == "__main__":
    main()