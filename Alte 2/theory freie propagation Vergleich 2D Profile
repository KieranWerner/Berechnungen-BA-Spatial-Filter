all_rows = []
profiles_at_compare_z = {}
dx_map = {}

for int_path, pha_path, label in FILE_PAIRS:
    print(f"Verarbeite: {label}")

    intensity = load_csv_auto(int_path)
    phase = load_csv_auto(pha_path)

    if intensity.shape != phase.shape:
        raise ValueError(
            f"Shape mismatch bei {label}: INT {intensity.shape} vs PHA {phase.shape}"
        )

    mask = make_valid_mask(intensity)

    tmp = np.zeros_like(intensity, dtype=float)
    tmp[mask] = intensity[mask]

    scale_metrics = beam_metrics(tmp, 1.0, 1.0)
    scale = scale_metrics["D4sigma_mm"] / 1e3

    dx = (INPUT_D4SIGMA_MM / scale) * 1e-3
    dy = dx
    dx_map[label] = dx

    U0 = build_field(intensity, phase, mask)

    rows = []

    for z in Z_LIST:
        Uz = U0 if z == 0 else angular_spectrum(U0, dx, dy, WAVELENGTH_M, z)
        Iz = np.abs(Uz) ** 2

        metrics = beam_metrics(Iz, dx, dy)

        row = {
            "label": label,
            "z": z,
            **metrics
        }
        rows.append(row)

        if np.isclose(z, COMPARE_Z):
            profiles_at_compare_z[label] = Iz.copy()

    all_rows.extend(rows)

    single_csv = OUTPUT_DIR / f"{label.replace(' ', '_')}_beam_size_vs_z.csv"
    with open(single_csv, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=list(rows[0].keys()))
        writer.writeheader()
        writer.writerows(rows)

