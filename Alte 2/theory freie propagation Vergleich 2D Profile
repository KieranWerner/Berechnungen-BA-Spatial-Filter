if len(FILE_PAIRS) != 2:
    print("2D-Differenzbild wird nur erstellt, wenn genau 2 Dateien verglichen werden.")
else:
    label1 = FILE_PAIRS[0][2]
    label2 = FILE_PAIRS[1][2]

    if label1 not in profiles_at_compare_z or label2 not in profiles_at_compare_z:
        print(f"Kein gespeichertes Profil für z = {COMPARE_Z} m gefunden.")
    else:
        I1 = profiles_at_compare_z[label1]
        I2 = profiles_at_compare_z[label2]

        # optional normieren, damit Form statt absoluter Leistung verglichen wird
        I1_norm = I1 / np.max(I1) if np.max(I1) > 0 else I1
        I2_norm = I2 / np.max(I2) if np.max(I2) > 0 else I2

        diff_abs = I1_norm - I2_norm

        denom = np.maximum(I2_norm, 1e-12)
        diff_rel = (I1_norm - I2_norm) / denom

        dx = dx_map[label1]
        ny, nx = I1.shape
        x_mm = (np.arange(nx) - (nx - 1) / 2.0) * dx * 1e3
        y_mm = (np.arange(ny) - (ny - 1) / 2.0) * dx * 1e3
        extent = [x_mm[0], x_mm[-1], y_mm[0], y_mm[-1]]

        # 4er-Panel
        fig, ax = plt.subplots(2, 2, figsize=(12, 10))

        im0 = ax[0, 0].imshow(I1_norm, origin="lower", extent=extent)
        ax[0, 0].set_title(f"{label1} @ z={COMPARE_Z} m")
        ax[0, 0].set_xlabel("x [mm]")
        ax[0, 0].set_ylabel("y [mm]")
        plt.colorbar(im0, ax=ax[0, 0], fraction=0.046, pad=0.04)

        im1 = ax[0, 1].imshow(I2_norm, origin="lower", extent=extent)
        ax[0, 1].set_title(f"{label2} @ z={COMPARE_Z} m")
        ax[0, 1].set_xlabel("x [mm]")
        ax[0, 1].set_ylabel("y [mm]")
        plt.colorbar(im1, ax=ax[0, 1], fraction=0.046, pad=0.04)

        vmax_abs = np.max(np.abs(diff_abs))
        im2 = ax[1, 0].imshow(
            diff_abs,
            origin="lower",
            extent=extent,
            vmin=-vmax_abs,
            vmax=vmax_abs
        )
        ax[1, 0].set_title(f"Absolute difference (normalized)\n{label1} - {label2}")
        ax[1, 0].set_xlabel("x [mm]")
        ax[1, 0].set_ylabel("y [mm]")
        plt.colorbar(im2, ax=ax[1, 0], fraction=0.046, pad=0.04)

        vmax_rel = np.nanpercentile(np.abs(diff_rel), 99)
        im3 = ax[1, 1].imshow(
            diff_rel,
            origin="lower",
            extent=extent,
            vmin=-vmax_rel,
            vmax=vmax_rel
        )
        ax[1, 1].set_title(f"Relative difference\n({label1} - {label2}) / {label2}")
        ax[1, 1].set_xlabel("x [mm]")
        ax[1, 1].set_ylabel("y [mm]")
        plt.colorbar(im3, ax=ax[1, 1], fraction=0.046, pad=0.04)

        plt.tight_layout()
        plt.savefig(OUTPUT_DIR / f"2D_comparison_at_{COMPARE_Z:.1f}m.png", dpi=180)
        plt.savefig(OUTPUT_DIR / f"2D_comparison_at_{COMPARE_Z:.1f}m.pdf")
        plt.close()

        # zusätzlich CSV/NPY speichern
        np.save(OUTPUT_DIR / f"{label1}_profile_{COMPARE_Z:.1f}m.npy", I1_norm)
        np.save(OUTPUT_DIR / f"{label2}_profile_{COMPARE_Z:.1f}m.npy", I2_norm)
        np.save(OUTPUT_DIR / f"diff_abs_{COMPARE_Z:.1f}m.npy", diff_abs)
        np.save(OUTPUT_DIR / f"diff_rel_{COMPARE_Z:.1f}m.npy", diff_rel)

        # zentrale Schnitte zusätzlich plotten
        cy = I1.shape[0] // 2
        cx = I1.shape[1] // 2

        plt.figure(figsize=(10, 5))
        plt.plot(x_mm, I1_norm[cy, :], label=f"{label1} horizontal")
        plt.plot(x_mm, I2_norm[cy, :], label=f"{label2} horizontal")
        plt.plot(x_mm, diff_abs[cy, :], linestyle="--", label="difference horizontal")
        plt.xlabel("x [mm]")
        plt.ylabel("normalized intensity / difference")
        plt.title(f"Central horizontal profile at z={COMPARE_Z} m")
        plt.grid(True, alpha=0.3)
        plt.legend()
        plt.tight_layout()
        plt.savefig(OUTPUT_DIR / f"central_horizontal_profile_{COMPARE_Z:.1f}m.png", dpi=180)
        plt.savefig(OUTPUT_DIR / f"central_horizontal_profile_{COMPARE_Z:.1f}m.pdf")
        plt.close()

