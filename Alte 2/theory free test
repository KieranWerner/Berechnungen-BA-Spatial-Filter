def save_size_plot(rows_with_phase, rows_without_phase, output_dir):
    plt.figure(figsize=(11, 7))

    z_with = [r["z_m"] for r in rows_with_phase]
    plt.plot(z_with, [r["D4sigma_avg_mm"] for r in rows_with_phase],
             marker="o", label="D4sigma_avg (with phase)")
    plt.plot(z_with, [r["D_EE50_mm"] for r in rows_with_phase],
             marker="s", label="D_EE50 (with phase)")
    plt.plot(z_with, [r["D_EE86_mm"] for r in rows_with_phase],
             marker="^", label="D_EE86 (with phase)")
    plt.plot(z_with, [r["D_area_50pct_mm"] for r in rows_with_phase],
             marker="d", label="D_area_50pct (with phase)")
    plt.plot(z_with, [r["D_area_13p5pct_mm"] for r in rows_with_phase],
             marker="v", label="D_area_13p5pct (with phase)")
    plt.plot(z_with, [r["FWHM_avg_mm"] for r in rows_with_phase],
             marker="P", label="FWHM_avg (with phase)")

    if rows_without_phase is None:
        z_without = [r["z_m"] for r in rows_without_phase]
        plt.plot(z_without, [r["D4sigma_avg_mm"] for r in rows_without_phase],
                 marker="o", linestyle="--", label="D4sigma_avg (without phase)")
        plt.plot(z_without, [r["D_EE50_mm"] for r in rows_without_phase],
                 marker="s", linestyle="--", label="D_EE50 (without phase)")
        plt.plot(z_without, [r["D_EE86_mm"] for r in rows_without_phase],
                 marker="^", linestyle="--", label="D_EE86 (without phase)")
        plt.plot(z_without, [r["D_area_50pct_mm"] for r in rows_without_phase],
                 marker="d", linestyle="--", label="D_area_50pct (without phase)")
        plt.plot(z_without, [r["D_area_13p5pct_mm"] for r in rows_without_phase],
                 marker="v", linestyle="--", label="D_area_13p5pct (without phase)")
        plt.plot(z_without, [r["FWHM_avg_mm"] for r in rows_without_phase],
                 marker="P", linestyle="--", label="FWHM_avg (without phase)")

    plt.xlabel("Propagation distance z [m]")
    plt.ylabel("Beam size [mm]")
    plt.title("Beam size versus propagation distance")
    plt.grid(True, alpha=0.3)
    plt.legend(fontsize=8, ncol=2)
    plt.tight_layout()
    plt.savefig(output_dir / "beam_size_vs_z_6_definitions.png", dpi=180)
    plt.close()


def save_input_diagnostics(intensity, int_norm, phase_data, valid_mask, output_dir):
    plt.figure(figsize=(6, 5))
    plt.imshow(intensity, origin="lower")
    plt.colorbar(label="Intensity")
    plt.title("Input intensity")
    plt.tight_layout()
    plt.savefig(output_dir / "input_intensity_raw.png", dpi=180)
    plt.close()

    plt.figure(figsize=(6, 5))
    plt.imshow(int_norm, origin="lower")
    plt.colorbar(label="Normalized intensity")
    plt.title("Input normalized intensity (masked)")
    plt.tight_layout()
    plt.savefig(output_dir / "input_intensity_masked.png", dpi=180)
    plt.close()

    plt.figure(figsize=(6, 5))
    phase_plot = np.full_like(phase_data, np.nan, dtype=float)
    phase_plot[valid_mask] = phase_data[valid_mask]
    plt.imshow(phase_plot, origin="lower")
    plt.colorbar(label=f"Phase [{PHASE_UNIT}]")
    plt.title("Input phase map (masked)")
    plt.tight_layout()
    plt.savefig(output_dir / "input_phase_masked.png", dpi=180)
    plt.close()

    plt.figure(figsize=(6, 5))
    plt.imshow(valid_mask.astype(float), origin="lower")
    plt.colorbar(label="Valid mask")
    plt.title("Aperture mask")
    plt.tight_layout()
    plt.savefig(output_dir / "aperture_mask.png", dpi=180)
    plt.close()


def save_selected_propagated_intensities(intensity_stack, output_dir, prefix, count=4):
    if len(intensity_stack) == 0:
        return

    idxs = np.linspace(0, len(intensity_stack) - 1, min(count, len(intensity_stack)), dtype=int)

    for i in idxs:
        z, I = intensity_stack[i]
        plt.figure(figsize=(6, 5))
        plt.imshow(I, origin="lower")
        plt.colorbar(label="Intensity")
        plt.title(f"{prefix}: propagated intensity at z = {z:.3f} m")
        plt.tight_layout()
        plt.savefig(output_dir / f"{prefix}_intensity_z_{z:.3f}m.png", dpi=180)
        plt.close()


# ============================================================
# HAUPTPROGRAMM
# ============================================================
def main():
    phase_data = load_csv_auto(PHA_FILE)
    intensity_raw = load_csv_auto(INT_FILE)

    if phase_data.shape != intensity_raw.shape:
        raise ValueError(
            f"Shape mismatch: phase {phase_data.shape} vs intensity {intensity_raw.shape}"
        )

    intensity = preprocess_intensity(
        intensity_raw,
        subtract_background=SUBTRACT_BACKGROUND,
        background_percentile=BACKGROUND_PERCENTILE,
    )

    valid_mask, threshold_abs, cx, cy = make_valid_mask(
        intensity=intensity,
        threshold_rel=INTENSITY_THRESHOLD_REL,
        use_circle=USE_CIRCLE_MASK,
        circle_radius_px=CIRCLE_RADIUS_PX,
        cx=CIRCLE_CENTER_X,
        cy=CIRCLE_CENTER_Y,
    )

    dx_m = determine_pixel_size_m(intensity, valid_mask)
    dy_m = dx_m

    U0_with_phase, int_norm = build_field_from_measurement(
        intensity=intensity,
        valid_mask=valid_mask,
        phase_data=phase_data,
        use_phase=True,
        phase_sign=PHASE_SIGN,
        phase_unit=PHASE_UNIT,
    )

    rows_with_phase, stack_with_phase = propagate_and_analyze(
        label="with_phase",
        U0=U0_with_phase,
        dx_m=dx_m,
        dy_m=dy_m,
        wavelength_m=WAVELENGTH_M,
        z_list_m=Z_LIST_M,
        output_dir=OUTPUT_DIR,
    )

    rows_without_phase = None
    stack_without_phase = None

    if CALCULATE_WITHOUT_PHASE:
        U0_without_phase, _ = build_field_from_measurement(
            intensity=intensity,
            valid_mask=valid_mask,
            phase_data=None,
            use_phase=False,
            phase_sign=PHASE_SIGN,
            phase_unit=PHASE_UNIT,
        )

        rows_without_phase, stack_without_phase = propagate_and_analyze(
            label="without_phase",
            U0=U0_without_phase,
            dx_m=dx_m,
            dy_m=dy_m,
            wavelength_m=WAVELENGTH_M,
            z_list_m=Z_LIST_M,
            output_dir=OUTPUT_DIR,
        )

    # kombinierte CSV
    all_rows = list(rows_with_phase)
    if rows_without_phase is not None:
        all_rows += rows_without_phase

    with open(OUTPUT_DIR / "beam_size_vs_z_comparison.csv", "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=list(all_rows[0].keys()))
        writer.writeheader()
        writer.writerows(all_rows)

    save_size_plot(rows_with_phase, rows_without_phase, OUTPUT_DIR)
    save_input_diagnostics(intensity, int_norm, phase_data, valid_mask, OUTPUT_DIR)
    save_selected_propagated_intensities(stack_with_phase, OUTPUT_DIR, "with_phase", count=4)

    if stack_without_phase is not None:
        save_selected_propagated_intensities(stack_without_phase, OUTPUT_DIR, "without_phase", count=4)

    meta = {
        "phase_file": str(PHA_FILE),
        "intensity_file": str(INT_FILE),
        "pixel_size_um": dx_m * 1e6,
        "wavelength_nm": WAVELENGTH_M * 1e9,
        "phase_unit": PHASE_UNIT,
        "phase_sign": PHASE_SIGN,
        "intensity_threshold_rel": INTENSITY_THRESHOLD_REL,
        "intensity_threshold_abs": threshold_abs,
        "use_circle_mask": USE_CIRCLE_MASK,
        "circle_radius_px": CIRCLE_RADIUS_PX,
        "circle_center_x_px": cx,
        "circle_center_y_px": cy,
        "use_direct_pixel_size": USE_DIRECT_PIXEL_SIZE,
        "pixel_size_input_um": PIXEL_SIZE_UM,
        "use_d4sigma_calibration": USE_D4SIGMA_CALIBRATION,
        "input_d4sigma_mm": INPUT_D4SIGMA_MM,
        "subtract_background": SUBTRACT_BACKGROUND,
        "background_percentile": BACKGROUND_PERCENTILE,
        "z_list_m": Z_LIST_M,
        "size_definitions": [
            "D4sigma_avg",
            "D_EE50",
            "D_EE86",
            "D_area_50pct",
            "D_area_13p5pct",
            "FWHM_avg",
        ],
    }

    with open(OUTPUT_DIR / "run_metadata.json", "w", encoding="utf-8") as f:
        json.dump(meta, f, indent=2)

    print("Done.")
    print(f"Pixel size: {dx_m * 1e6:.3f} um")
    print(f"Threshold abs.: {threshold_abs:.6g}")
    print(f"Valid pixels: {int(valid_mask.sum())}")
    print(f"Results written to: {OUTPUT_DIR}")


if __name__ == "__main__":
    main()