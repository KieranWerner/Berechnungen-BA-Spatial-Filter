from pathlib import Path
import numpy as np
import matplotlib.pyplot as plt


# ============================================================
# SETTINGS
# ============================================================
INPUT_DIR = Path(r"C:\Users\User\Desktop\Eingabe")
OUTPUT_DIR = INPUT_DIR

FILE_PATTERN = "PHA*.int"
INVALID_VALUE = -32768.0

# Optional cropping of outer border pixels
CROP_BORDER = 0

# Plot settings
FIG_DPI = 300
FIGSIZE = (6.8, 5.8)


# ============================================================
# READ SID4 .int FILE
# ============================================================
def read_sid4_int(file_path: Path) -> np.ndarray:
    """
    Read a SID4 .int file and return the image as a 2D float64 array.
    """
    with open(file_path, "r", encoding="latin1") as f:
        lines = f.readlines()

    grd_index = None
    height = None
    width = None

    for i, line in enumerate(lines):
        if line.startswith("GRD"):
            parts = line.strip().split("\t")
            if len(parts) < 3:
                raise ValueError(f"Invalid GRD line in file: {file_path}")
            height = int(parts[1])
            width = int(parts[2])
            grd_index = i
            break

    if grd_index is None:
        raise ValueError(f"No GRD line found in file: {file_path}")

    values = []
    for line in lines[grd_index + 1:]:
        line = line.strip()
        if not line:
            continue
        for item in line.split("\t"):
            if item != "":
                values.append(float(item))

    arr = np.array(values, dtype=np.float64)

    expected_size = height * width
    if arr.size != expected_size:
        raise ValueError(
            f"{file_path.name}: expected {expected_size} values, found {arr.size}"
        )

    return arr.reshape((height, width))


# ============================================================
# HELPERS
# ============================================================
def crop_if_needed(img: np.ndarray, border: int) -> np.ndarray:
    if border <= 0:
        return img
    return img[border:-border, border:-border]


def save_map(
    img: np.ndarray,
    out_path: Path,
    title: str,
    colorbar_label: str,
    cmap: str = "twilight",
):
    fig, ax = plt.subplots(figsize=FIGSIZE)
    im = ax.imshow(img, cmap=cmap, origin="upper")

    ax.set_title(title, fontsize=14)
    ax.set_xlabel("x [pixel]", fontsize=12)
    ax.set_ylabel("y [pixel]", fontsize=12)
    ax.tick_params(axis="both", labelsize=10)

    cbar = fig.colorbar(im, ax=ax)
    cbar.set_label(colorbar_label, fontsize=11)
    cbar.ax.tick_params(labelsize=10)

    fig.tight_layout()
    fig.savefig(out_path, dpi=FIG_DPI, bbox_inches="tight")
    plt.close(fig)


def print_stats(name: str, arr: np.ndarray) -> None:
    finite = np.isfinite(arr)
    if not np.any(finite):
        print(f"{name}: no finite values")
        return

    values = arr[finite]
    print(f"{name}:")
    print(f"  shape = {arr.shape}")
    print(f"  min   = {np.min(values):.6e}")
    print(f"  max   = {np.max(values):.6e}")
    print(f"  mean  = {np.mean(values):.6e}")
    print(f"  std   = {np.std(values):.6e}")


# ============================================================
# CLEANING
# ============================================================
def clean_phase_image(img: np.ndarray, invalid_value: float) -> tuple[np.ndarray, np.ndarray]:
    """
    Clean one phase image.

    Rules:
    - invalid sentinel values are removed
    - non-finite values are removed

    Returns
    -------
    cleaned_img : np.ndarray
        Same image, but invalid pixels replaced by NaN.
    valid_mask : np.ndarray
        Boolean mask of valid pixels.
    """
    cleaned_img = img.astype(np.float64).copy()

    valid_mask = np.isfinite(cleaned_img)
    valid_mask &= cleaned_img != invalid_value

    cleaned_img[~valid_mask] = np.nan

    return cleaned_img, valid_mask


# ============================================================
# MAIN
# ============================================================
def main():
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    pha_files = sorted(INPUT_DIR.glob(FILE_PATTERN))

    if not pha_files:
        raise FileNotFoundError(
            f"No files matching '{FILE_PATTERN}' found in the input folder."
        )

    print(f"Found {len(pha_files)} phase files.")

    stack = []
    valid_masks = []

    for i, file_path in enumerate(pha_files, start=1):
        img = read_sid4_int(file_path)
        img = crop_if_needed(img, CROP_BORDER)

        cleaned_img, valid_mask = clean_phase_image(img, INVALID_VALUE)

        stack.append(cleaned_img)
        valid_masks.append(valid_mask)

        if i <= 3:
            print(f"Example file {i}: {file_path.name}, shape = {cleaned_img.shape}")

    stack = np.stack(stack, axis=0)
    valid_masks = np.stack(valid_masks, axis=0)

    print(f"Stack shape: {stack.shape}")

    # Mean and standard deviation ignoring invalid pixels
    mean_phase = np.nanmean(stack, axis=0)
    std_phase = np.nanstd(stack, axis=0)
    valid_count = np.sum(valid_masks, axis=0)

    # Final valid mask: at least one valid sample at this pixel
    final_valid_mask = valid_count > 0

    # Replace NaNs outside the valid region by zero
    mean_phase = np.nan_to_num(mean_phase, nan=0.0)
    std_phase = np.nan_to_num(std_phase, nan=0.0)

    # Coordinate vectors in pixels
    ny, nx = mean_phase.shape
    x = np.arange(nx, dtype=np.float64)
    y = np.arange(ny, dtype=np.float64)

    print_stats("Mean phase (clean)", mean_phase)
    print_stats("Phase standard deviation (clean)", std_phase)
    print(f"Valid pixels in final mask: {np.sum(final_valid_mask)} / {final_valid_mask.size}")

    # --------------------------------------------------------
    # SAVE NUMERICAL OUTPUTS
    # --------------------------------------------------------
    np.save(OUTPUT_DIR / "phase_stack_clean.npy", stack)
    np.save(OUTPUT_DIR / "phase_mean_clean.npy", mean_phase)
    np.save(OUTPUT_DIR / "phase_std_clean.npy", std_phase)
    np.save(OUTPUT_DIR / "phase_valid_mask.npy", final_valid_mask.astype(np.uint8))
    np.save(OUTPUT_DIR / "phase_valid_count.npy", valid_count)

    np.savetxt(OUTPUT_DIR / "phase_mean_clean.csv", mean_phase, delimiter=",")
    np.savetxt(OUTPUT_DIR / "phase_std_clean.csv", std_phase, delimiter=",")

    # Main output file for later propagation
    np.savez_compressed(
        OUTPUT_DIR / "phase_propagation_input.npz",
        phase=mean_phase,
        phase_std=std_phase,
        valid_mask=final_valid_mask.astype(np.uint8),
        valid_count=valid_count,
        x=x,
        y=y,
    )

    # --------------------------------------------------------
    # SAVE FIGURES
    # --------------------------------------------------------
    save_map(
        mean_phase,
        OUTPUT_DIR / "phase_mean_clean.png",
        "Mean cleaned phase",
        "phase value",
        cmap="twilight",
    )

    save_map(
        std_phase,
        OUTPUT_DIR / "phase_std_clean.png",
        "Standard deviation of cleaned phase",
        "standard deviation",
        cmap="viridis",
    )

    save_map(
        final_valid_mask.astype(float),
        OUTPUT_DIR / "phase_valid_mask.png",
        "Valid phase mask",
        "valid pixel",
        cmap="gray",
    )

    save_map(
        valid_count.astype(np.float64),
        OUTPUT_DIR / "phase_valid_count.png",
        "Number of valid phase samples per pixel",
        "valid sample count",
        cmap="gray",
    )

    print("\nFinished.")
    print(f"Output folder: {OUTPUT_DIR}")
    print("Most important output files:")
    print(f"  {OUTPUT_DIR / 'phase_mean_clean.npy'}")
    print(f"  {OUTPUT_DIR / 'phase_propagation_input.npz'}")


if __name__ == "__main__":
    main()
    