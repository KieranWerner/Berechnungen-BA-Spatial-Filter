def ensure_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)


def load_tiff(path: Path) -> np.ndarray:
    img = Image.open(path)
    arr = np.array(img, dtype=np.float64)

    # Convert color image to grayscale if needed
    if arr.ndim == 3:
        arr = arr.mean(axis=2)

    if arr.ndim != 2:
        raise ValueError(f"{path.name}: expected a 2D image, got shape={arr.shape}")

    return arr


def subtract_background(img: np.ndarray, percentile: float = BACKGROUND_PERCENTILE) -> np.ndarray:
    bg = float(np.percentile(img, percentile))
    out = img.astype(np.float64) - bg
    out[out < 0] = 0.0
    return out


def weighted_centroid(img: np.ndarray) -> tuple[float, float]:
    total = float(img.sum())
    if total <= 0:
        raise ValueError("Image contains no positive signal after background subtraction.")

    y, x = np.indices(img.shape)
    cx = float((img * x).sum() / total)
    cy = float((img * y).sum() / total)
    return cx, cy


def second_moments(img: np.ndarray) -> tuple[float, float, float]:
    """
    Returns sigma_x, sigma_y and the mixed covariance term cov_xy.
    """
    total = float(img.sum())
    if total <= 0:
        raise ValueError("Image contains no positive signal.")

    y, x = np.indices(img.shape)
    cx, cy = weighted_centroid(img)

    dx = x - cx
    dy = y - cy

    var_x = float((img * dx**2).sum() / total)
    var_y = float((img * dy**2).sum() / total)
    cov_xy = float((img * dx * dy).sum() / total)

    sigma_x = math.sqrt(max(var_x, 1e-15))
    sigma_y = math.sqrt(max(var_y, 1e-15))
    return sigma_x, sigma_y, cov_xy


def principal_axes_from_covariance(
    sigma_x: float,
    sigma_y: float,
    cov_xy: float,
) -> tuple[float, float, float]:
    """
    Returns:
        sigma_major, sigma_minor, theta_rad

    based on the covariance matrix eigenvalues/eigenvectors.
    """
    cov = np.array(
        [
            [sigma_x**2, cov_xy],
            [cov_xy, sigma_y**2],
        ],
        dtype=float,
    )

    eigvals, eigvecs = np.linalg.eigh(cov)
    order = np.argsort(eigvals)[::-1]
    eigvals = eigvals[order]
    eigvecs = eigvecs[:, order]

    sigma_major = math.sqrt(max(eigvals[0], 1e-12))
    sigma_minor = math.sqrt(max(eigvals[1], 1e-12))
    theta = math.atan2(eigvecs[1, 0], eigvecs[0, 0])

    return sigma_major, sigma_minor, theta


def sanitize_filename(name: str) -> str:
    return "".join(c if c.isalnum() or c in "._-" else "_" for c in name)


def extract_position_cm_from_filename(path: Path) -> float:
    """
    Extracts the longitudinal beam position in cm from the filename.

    Examples:
        350.tiff      -> 350.0
        350cm.tiff    -> 350.0
        pos_350cm.tif -> 350.0
        z=350.5cm.tif -> 350.5
    """
    stem = path.stem.strip()

    matches_cm = re.findall(r"([-+]?\d+(?:[.,]\d+)?)\s*cm", stem, flags=re.IGNORECASE)
    if matches_cm:
        return float(matches_cm[-1].replace(",", "."))

    matches_num = re.findall(r"[-+]?\d+(?:[.,]\d+)?", stem)
    if matches_num:
        return float(matches_num[-1].replace(",", "."))

    raise ValueError(f"No position value could be extracted from filename: {path.name}")


# ============================================================
# ROTATED 2D GAUSSIAN FIT
# ============================================================

def gaussian_2d_rotated(
    xy: tuple[np.ndarray, np.ndarray],
    amplitude: float,
    x0: float,
    y0: float,
    sigma_x: float,
    sigma_y: float,
    theta: float,
    offset: float,
) -> np.ndarray:
    """
    Rotated 2D Gaussian:
    I(x,y) = offset + A * exp( -(a*(x-x0)^2 + 2b(x-x0)(y-y0) + c*(y-y0)^2) )
    """
    x, y = xy
    sigma_x = max(float(sigma_x), 1e-9)
    sigma_y = max(float(sigma_y), 1e-9)

    ct = math.cos(theta)
    st = math.sin(theta)

    a = (ct**2) / (2.0 * sigma_x**2) + (st**2) / (2.0 * sigma_y**2)
    b = (-math.sin(2.0 * theta)) / (4.0 * sigma_x**2) + (math.sin(2.0 * theta)) / (4.0 * sigma_y**2)
    c = (st**2) / (2.0 * sigma_x**2) + (ct**2) / (2.0 * sigma_y**2)

    g = offset + amplitude * np.exp(
        -(a * (x - x0) ** 2 + 2.0 * b * (x - x0) * (y - y0) + c * (y - y0) ** 2)
    )
    return g.ravel()


def initial_guess_from_moments(img: np.ndarray) -> list[float]:
    ny, nx = img.shape
    cx, cy = weighted_centroid(img)
    sigma_x, sigma_y, cov_xy = second_moments(img)
    sigma_major, sigma_minor, theta = principal_axes_from_covariance(sigma_x, sigma_y, cov_xy)

    offset0 = float(np.percentile(img, 5))
    amplitude0 = float(np.max(img) - offset0)
    amplitude0 = max(amplitude0, 1.0)

    sigma_major = min(max(sigma_major, 1.0), max(nx, ny))
    sigma_minor = min(max(sigma_minor, 1.0), max(nx, ny))

    return [amplitude0, cx, cy, sigma_major, sigma_minor, theta, offset0]


def fit_gaussian_2d(img: np.ndarray) -> tuple[dict[str, float], np.ndarray]:
    if np.max(img) <= 0:
        raise ValueError("No positive signal available for fitting.")

    ny, nx = img.shape
    y, x = np.indices(img.shape)

    threshold = FIT_THRESHOLD_REL * float(np.max(img))
    fit_mask = img >= threshold
    if np.count_nonzero(fit_mask) < 30:
        fit_mask = np.ones_like(img, dtype=bool)

    x_fit = x[fit_mask].astype(float)
    y_fit = y[fit_mask].astype(float)
    z_fit = img[fit_mask].astype(float)

    p0 = initial_guess_from_moments(img)

    lower_offset = -np.inf if ALLOW_NEGATIVE_OFFSET else 0.0
    lower_bounds = np.array([0.0, 0.0, 0.0, 0.2, 0.2, -np.pi / 2.0, lower_offset], dtype=float)
    upper_bounds = np.array([np.inf, nx - 1.0, ny - 1.0, max(nx, ny), max(nx, ny), np.pi / 2.0, np.inf], dtype=float)

    p0 = np.asarray(p0, dtype=float)
    eps = np.array([1e-12, 1e-6, 1e-6, 1e-6, 1e-6, 1e-6, 1e-12], dtype=float)

    for i in range(len(p0)):
        lo = lower_bounds[i]
        hi = upper_bounds[i]

        if np.isfinite(lo) and p0[i] < lo:
            p0[i] = lo + eps[i]
        if np.isfinite(hi) and p0[i] > hi:
            p0[i] = hi - eps[i]

    popt, _ = curve_fit(
        gaussian_2d_rotated,
        (x_fit, y_fit),
        z_fit.ravel(),
        p0=p0,
        bounds=(lower_bounds, upper_bounds),
        maxfev=50000,
    )

    amplitude, x0, y0, sigma_x, sigma_y, theta, offset = [float(v) for v in popt]

    fit_img = gaussian_2d_rotated(
        (x.astype(float), y.astype(float)),
        amplitude, x0, y0, sigma_x, sigma_y, theta, offset
    ).reshape(img.shape)

    sigma_major = max(sigma_x, sigma_y)
    sigma_minor = min(sigma_x, sigma_y)

    params = {
        "amplitude": amplitude,
        "x0_px": x0,
        "y0_px": y0,
        "sigma_x_px": sigma_x,
        "sigma_y_px": sigma_y,
        "sigma_major_px": sigma_major,
        "sigma_minor_px": sigma_minor,
        "theta_rad": theta,
        "theta_deg": math.degrees(theta),
        "offset": offset,
    }
    return params, fit_img


# ============================================================
# PROFILES / BEAM METRICS
# ============================================================

def fwhm_from_sigma(sigma: float) -> float:
    return 2.0 * math.sqrt(2.0 * math.log(2.0)) * sigma


def unit_label() -> str:
    return "mm" if PIXEL_SIZE_UM is not None else "px"


def scale_axis(values_px: np.ndarray) -> np.ndarray:
    if PIXEL_SIZE_UM is None:
        return values_px
    return values_px * PIXEL_SIZE_UM / 1000.0


def scale_value(value_px: float) -> float:
    if PIXEL_SIZE_UM is None:
        return value_px
    return value_px * PIXEL_SIZE_UM / 1000.0


def extract_center_profiles(img: np.ndarray, x0: float, y0: float) -> tuple[np.ndarray, np.ndarray, int, int]:
    x_idx = int(np.clip(round(x0), 0, img.shape[1] - 1))
    y_idx = int(np.clip(round(y0), 0, img.shape[0] - 1))

    profile_x = img[y_idx, :]
    profile_y = img[:, x_idx]
    return profile_x, profile_y, x_idx, y_idx


def r_squared(y_true: np.ndarray, y_fit: np.ndarray) -> float:
    y_true = np.asarray(y_true, dtype=float)
    y_fit = np.asarray(y_fit, dtype=float)
    ss_res = float(np.sum((y_true - y_fit) ** 2))
    ss_tot = float(np.sum((y_true - np.mean(y_true)) ** 2))
    if ss_tot <= 0:
        return np.nan
    return 1.0 - ss_res / ss_tot


