def style_axes(ax: plt.Axes) -> None:
    ax.grid(True, alpha=0.22, linewidth=0.8)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.tick_params(axis="both", labelsize=FONT_SIZE_TICKS)


def make_publication_plot(
    img_raw: np.ndarray,
    img_fit: np.ndarray,
    fit: dict[str, float],
    input_path: Path,
    outdir: Path,
) -> None:
    x0 = fit["x0_px"]
    y0 = fit["y0_px"]
    sigma_x = fit["sigma_x_px"]
    sigma_y = fit["sigma_y_px"]
    sigma_major = fit["sigma_major_px"]
    sigma_minor = fit["sigma_minor_px"]
    theta_deg = fit["theta_deg"]

    profile_x_raw, profile_y_raw, _, _ = extract_center_profiles(img_raw, x0, y0)
    profile_x_fit, profile_y_fit, _, _ = extract_center_profiles(img_fit, x0, y0)

    x_axis_px = np.arange(img_raw.shape[1], dtype=float)
    y_axis_px = np.arange(img_raw.shape[0], dtype=float)

    x_axis_plot = scale_axis(x_axis_px)
    y_axis_plot = scale_axis(y_axis_px)

    unit = unit_label()

    d_1e2_major = 4.0 * sigma_major
    d_1e2_minor = 4.0 * sigma_minor
    fwhm_major = fwhm_from_sigma(sigma_major)
    fwhm_minor = fwhm_from_sigma(sigma_minor)

    d_1e2_major_plot = scale_value(d_1e2_major)
    d_1e2_minor_plot = scale_value(d_1e2_minor)
    fwhm_major_plot = scale_value(fwhm_major)
    fwhm_minor_plot = scale_value(fwhm_minor)

    r2_x = r_squared(profile_x_raw, profile_x_fit)
    r2_y = r_squared(profile_y_raw, profile_y_fit)

    fig = plt.figure(figsize=(14, 8.8))
    gs = fig.add_gridspec(
        2, 2,
        width_ratios=[1.1, 1.0],
        height_ratios=[1.0, 1.0],
        wspace=0.30,
        hspace=0.32,
    )

    # 2D intensity map
    ax0 = fig.add_subplot(gs[:, 0])

    extent = None
    if PIXEL_SIZE_UM is not None:
        extent = [
            scale_value(0),
            scale_value(img_raw.shape[1] - 1),
            scale_value(img_raw.shape[0] - 1),
            scale_value(0),
        ]

    im = ax0.imshow(img_raw, cmap=CMAP, origin="upper", extent=extent)
    cbar = fig.colorbar(im, ax=ax0, fraction=0.046, pad=0.04)
    cbar.set_label("Intensity [a.u.]", fontsize=FONT_SIZE_LABEL)
    cbar.ax.tick_params(labelsize=FONT_SIZE_TICKS)

    x0_plot = scale_value(x0)
    y0_plot = scale_value(y0)
    ax0.plot(x0_plot, y0_plot, marker="+", markersize=13, markeredgewidth=2.2, color="white")

    ellipse_width = scale_value(4.0 * sigma_x)
    ellipse_height = scale_value(4.0 * sigma_y)

    ell = Ellipse(
        xy=(x0_plot, y0_plot),
        width=ellipse_width,
        height=ellipse_height,
        angle=theta_deg,
        fill=False,
        linewidth=2.4,
        edgecolor="white",
    )
    ax0.add_patch(ell)

    ax0.set_title("2D Intensity Distribution with Gaussian Fit", fontsize=FONT_SIZE_TITLE, pad=10)
    ax0.set_xlabel(f"x [{unit}]", fontsize=FONT_SIZE_LABEL)
    ax0.set_ylabel(f"y [{unit}]", fontsize=FONT_SIZE_LABEL)
    ax0.tick_params(axis="both", labelsize=FONT_SIZE_TICKS)

    # Horizontal profile
    ax1 = fig.add_subplot(gs[0, 1])
    ax1.plot(x_axis_plot, profile_x_raw, linewidth=2.0, label="Measured profile")
    ax1.plot(x_axis_plot, profile_x_fit, "--", linewidth=2.0, label="Gaussian fit")
    ax1.set_title("Horizontal Beam Profile", fontsize=FONT_SIZE_TITLE, pad=8)
    ax1.set_xlabel(f"x [{unit}]", fontsize=FONT_SIZE_LABEL)
    ax1.set_ylabel("Intensity [a.u.]", fontsize=FONT_SIZE_LABEL)
    style_axes(ax1)
    ax1.legend(frameon=False, fontsize=FONT_SIZE_LEGEND)

    # Vertical profile
    ax2 = fig.add_subplot(gs[1, 1])
    ax2.plot(y_axis_plot, profile_y_raw, linewidth=2.0, label="Measured profile")
    ax2.plot(y_axis_plot, profile_y_fit, "--", linewidth=2.0, label="Gaussian fit")
    ax2.set_title("Vertical Beam Profile", fontsize=FONT_SIZE_TITLE, pad=8)
    ax2.set_xlabel(f"y [{unit}]", fontsize=FONT_SIZE_LABEL)
    ax2.set_ylabel("Intensity [a.u.]", fontsize=FONT_SIZE_LABEL)
    style_axes(ax2)
    ax2.legend(frameon=False, fontsize=FONT_SIZE_LEGEND)

    info_text = (
        f"File: {input_path.name}\n"
        f"Center: ({x0_plot:.2f}, {y0_plot:.2f}) {unit}\n"
        f"1/e² diameter (major): {d_1e2_major_plot:.2f} {unit}\n"
        f"1/e² diameter (minor): {d_1e2_minor_plot:.2f} {unit}\n"
        f"FWHM (major): {fwhm_major_plot:.2f} {unit}\n"
        f"FWHM (minor): {fwhm_minor_plot:.2f} {unit}\n"
        f"Rotation angle: {theta_deg:.2f}°\n"
        f"R² (horizontal profile): {r2_x:.4f}\n"
        f"R² (vertical profile): {r2_y:.4f}"
    )

    fig.text(
        0.64,
        0.08,
        info_text,
        fontsize=FONT_SIZE_TEXTBOX,
        bbox=dict(boxstyle="round", facecolor="white", alpha=0.92),
    )

    fig.suptitle("Gaussian Fit of the Laser Beam Intensity Distribution", fontsize=FONT_SIZE_TITLE + 2)
    fig.tight_layout(rect=[0, 0, 1, 0.97])

    stem = sanitize_filename(input_path.stem)
    if SAVE_PNG:
        fig.savefig(outdir / f"{stem}_gaussfit.png", dpi=DPI, bbox_inches="tight")
    if SAVE_SVG:
        fig.savefig(outdir / f"{stem}_gaussfit.svg", bbox_inches="tight")

    plt.close(fig)


def make_propagation_plot_major_minor(results: list[dict[str, float | str]], outdir: Path) -> None:
    if not results:
        print("No valid results available for the propagation plot.")
        return

    results_sorted = sorted(results, key=lambda r: float(r["z_cm"]))

    z_cm = np.array([float(r["z_cm"]) for r in results_sorted], dtype=float)
    d_major_px = np.array([float(r["d_major_px"]) for r in results_sorted], dtype=float)
    d_minor_px = np.array([float(r["d_minor_px"]) for r in results_sorted], dtype=float)

    d_major_plot = scale_axis(d_major_px)
    d_minor_plot = scale_axis(d_minor_px)

    unit = unit_label()

    # ===== PLOT =====
    fig, ax = plt.subplots(figsize=(10.5, 6.6))

    ax.plot(z_cm, d_major_plot, "o-", linewidth=2.2, markersize=6.8, label="Major axis diameter")
    ax.plot(z_cm, d_minor_plot, "s-", linewidth=2.2, markersize=6.2, label="Minor axis diameter")

    ax.set_title("Beam Diameter Along the Propagation Direction", fontsize=FONT_SIZE_TITLE)
    ax.set_xlabel("Beam position along propagation direction [cm]", fontsize=FONT_SIZE_LABEL)
    ax.set_ylabel(f"1/e² beam diameter [{unit}]", fontsize=FONT_SIZE_LABEL)
    style_axes(ax)
    ax.legend(frameon=False, fontsize=FONT_SIZE_LEGEND)

    fig.tight_layout()

    if SAVE_PNG:
        fig.savefig(outdir / "beam_propagation_major_minor.png", dpi=DPI, bbox_inches="tight")
    if SAVE_SVG:
        fig.savefig(outdir / "beam_propagation_major_minor.svg", bbox_inches="tight")

    plt.close(fig)

    # ===== CSV EXPORT =====
    csv_path = outdir / "beam_propagation_major_minor.csv"
    with open(csv_path, "w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["z_cm", f"diameter_major_{unit}", f"diameter_minor_{unit}"])
        for z, dmaj, dmin in zip(z_cm, d_major_plot, d_minor_plot):
            writer.writerow([z, dmaj, dmin])

    print(f"Saved CSV: {csv_path}")


def make_propagation_plot_average(results: list[dict[str, float | str]], outdir: Path) -> None:
    if not results:
        print("No valid results available for the average propagation plot.")
        return

    results_sorted = sorted(results, key=lambda r: float(r["z_cm"]))

    z_cm = np.array([float(r["z_cm"]) for r in results_sorted], dtype=float)
    d_major_px = np.array([float(r["d_major_px"]) for r in results_sorted], dtype=float)
    d_minor_px = np.array([float(r["d_minor_px"]) for r in results_sorted], dtype=float)

    # Mean diameter
    d_mean_px = 0.5 * (d_major_px + d_minor_px)

    # Error = half difference between major and minor axis
    d_error_px = 0.5 * np.abs(d_major_px - d_minor_px)

    d_mean_plot = scale_axis(d_mean_px)
    d_error_plot = scale_axis(d_error_px)

    unit = unit_label()

    # ===== PLOT =====
    fig, ax = plt.subplots(figsize=(10.5, 6.6))

    ax.errorbar(
        z_cm,
        d_mean_plot,
        yerr=d_error_plot,
        fmt="o-",
        linewidth=2.4,
        markersize=7.0,
        capsize=4,
        label="Mean diameter ± ellipticity"
    )

    ax.set_title("Mean Beam Diameter Along the Propagation Direction", fontsize=FONT_SIZE_TITLE)
    ax.set_xlabel("Beam position along propagation direction [cm]", fontsize=FONT_SIZE_LABEL)
    ax.set_ylabel(f"Mean 1/e² beam diameter [{unit}]", fontsize=FONT_SIZE_LABEL)

    style_axes(ax)
    ax.legend(frameon=False, fontsize=FONT_SIZE_LEGEND)

    fig.tight_layout()

    if SAVE_PNG:
        fig.savefig(outdir / "beam_propagation_mean.png", dpi=DPI, bbox_inches="tight")
    if SAVE_SVG:
        fig.savefig(outdir / "beam_propagation_mean.svg", bbox_inches="tight")

    plt.close(fig)

    # ===== CSV EXPORT =====
    csv_path = outdir / "beam_propagation_mean.csv"
    with open(csv_path, "w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["z_cm", f"diameter_mean_{unit}", f"error_{unit}"])
        for z, d, err in zip(z_cm, d_mean_plot, d_error_plot):
            writer.writerow([f"{z:.6f}", f"{d:.6f}", f"{err:.6f}"])

    print(f"Saved CSV: {csv_path}")

