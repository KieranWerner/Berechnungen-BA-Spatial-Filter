# MAIN
# ============================================================

def main() -> None:
    ensure_dir(OUTPUT_FOLDER)

    files = sorted(list(INPUT_FOLDER.glob("*.tif")) + list(INPUT_FOLDER.glob("*.tiff")))
    if not files:
        raise SystemExit(f"No TIFF files found in: {INPUT_FOLDER}")

    print(f"Number of TIFF files found: {len(files)}")
    print(f"Output folder: {OUTPUT_FOLDER}")

    propagation_results: list[dict[str, float | str]] = []

    for path in files:
        try:
            img = load_tiff(path)
            img_bg = subtract_background(img)
            fit_params, fit_img = fit_gaussian_2d(img_bg)

            make_publication_plot(img_bg, fit_img, fit_params, path, OUTPUT_FOLDER)

            z_cm = extract_position_cm_from_filename(path)

            sigma_major_px = fit_params["sigma_major_px"]
            sigma_minor_px = fit_params["sigma_minor_px"]

            d_major_px = 4.0 * sigma_major_px
            d_minor_px = 4.0 * sigma_minor_px
            d_mean_px = 0.5 * (d_major_px + d_minor_px)

            propagation_results.append(
                {
                    "file": path.name,
                    "z_cm": z_cm,
                    "x0_px": fit_params["x0_px"],
                    "y0_px": fit_params["y0_px"],
                    "sigma_major_px": sigma_major_px,
                    "sigma_minor_px": sigma_minor_px,
                    "d_major_px": d_major_px,
                    "d_minor_px": d_minor_px,
                    "d_mean_px": d_mean_px,
                    "theta_deg": fit_params["theta_deg"],
                }
            )

            print(
                f"OK: {path.name} | "
                f"z = {z_cm:.2f} cm, "
                f"major sigma = {sigma_major_px:.2f} px, "
                f"minor sigma = {sigma_minor_px:.2f} px, "
                f"rotation = {fit_params['theta_deg']:.2f}°"
            )

        except Exception as exc:
            print(f"ERROR for {path.name}: {exc}")

    make_propagation_plot_major_minor(propagation_results, OUTPUT_FOLDER)
