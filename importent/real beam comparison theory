def load_theory_csv(path: Path) -> list[dict[str, float]]:
    if not path.exists():
        raise SystemExit(f"Theorie-CSV nicht gefunden: {path}")

    rows = []
    with open(path, "r", encoding="utf-8-sig", newline="") as f:
        reader = csv.DictReader(f)
        for raw in reader:
            row = {}

            # z
            if "z_m" in raw and raw["z_m"] != "":
                row["z_m"] = float(raw["z_m"])* CFG["THEORY_SCALE"]
            elif "z_cm" in raw and raw["z_cm"] != "":
                row["z_m"] = float(raw["z_cm"]) / 100.0* CFG["THEORY_SCALE"]
            else:
                raise ValueError("In der Theorie-CSV wurde keine Spalte 'z_m' oder 'z_cm' gefunden.")

            # mögliche Namensvarianten
            mapping = {
                "D4sigma_avg": ["D4sigma_avg_mm", "D4sigma_avg"],
                "D_EE50": ["D_EE50_mm", "D_EE50"],
                "D_EE86": ["D_EE86_mm", "D_EE86"],
                "D_area_50pct": ["D_area_50pct_mm", "D_area_50pct"],
                "D_area_13p5pct": ["D_area_13p5pct_mm", "D_area_13p5pct"],
            }

            for target_key, candidates in mapping.items():
                found = False
                for c in candidates:
                    if c in raw and raw[c] not in ("", None):
                        row[target_key] = float(raw[c])
                        found = True
                        break
                if not found:
                    row[target_key] = np.nan

            rows.append(row)

    if not rows:
        raise SystemExit("Theorie-CSV ist leer.")

    rows.sort(key=lambda r: r["z_m"])
    return rows


# ============================================================
# VERGLEICH / INTERPOLATION
# ============================================================

def interpolate_theory_to_real_z(
    theory_rows: list[dict[str, float]],
    real_rows: list[dict[str, float]],
    keys: list[str],
) -> list[dict[str, float]]:
    z_theory = np.array([r["z_m"] for r in theory_rows], dtype=float)
    z_real = np.array([r["z_m"] for r in real_rows], dtype=float)

    out = []
    for i, zr in enumerate(z_real):
        row = {
            "z_m": zr,
            "file": real_rows[i].get("file", ""),
        }

        for key in keys:
            y_theory = np.array([r[key] for r in theory_rows], dtype=float)
            y_real = float(real_rows[i][key])

            valid = np.isfinite(z_theory) & np.isfinite(y_theory)
            if np.count_nonzero(valid) < 2:
                row[f"{key}_theory"] = np.nan
                row[f"{key}_real"] = y_real
                row[f"{key}_diff"] = np.nan
                continue

            zt = z_theory[valid]
            yt = y_theory[valid]

            if zr < np.min(zt) or zr > np.max(zt):
                theory_val = np.nan
            else:
                theory_val = float(np.interp(zr, zt, yt))

            row[f"{key}_theory"] = theory_val
            row[f"{key}_real"] = y_real
            row[f"{key}_diff"] = theory_val - y_real if np.isfinite(theory_val) else np.nan

        out.append(row)

    return out


def exact_match_theory_and_real(
    theory_rows: list[dict[str, float]],
    real_rows: list[dict[str, float]],
    keys: list[str],
    tol: float = 1e-9,
) -> list[dict[str, float]]:
    out = []
    for rr in real_rows:
        zr = rr["z_m"]
        match = None
        for tr in theory_rows:
            if abs(tr["z_m"] - zr) <= tol:
                match = tr
                break

        if match is None:
            continue

        row = {
            "z_m": zr,
            "file": rr.get("file", ""),
        }
        for key in keys:
            theory_val = float(match.get(key, np.nan))
            real_val = float(rr.get(key, np.nan))
            row[f"{key}_theory"] = theory_val
            row[f"{key}_real"] = real_val
            row[f"{key}_diff"] = theory_val - real_val
        out.append(row)

    return out


# ============================================================
# AUSGABE
# ============================================================

def save_comparison_csv(rows: list[dict[str, float]], output_dir: Path) -> Path:
    if not rows:
        raise RuntimeError("Keine Vergleichsdaten zum Speichern vorhanden.")

    out = output_dir / "theory_minus_real_comparison.csv"
    fieldnames = list(rows[0].keys())

    with open(out, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)

    return out


def plot_difference(rows: list[dict[str, float]], keys: list[str], output_dir: Path) -> Path:
    z = np.array([r["z_m"] for r in rows], dtype=float)

    plt.figure(figsize=(11, 7))
    for key in keys:
        y = np.array([r[f"{key}_diff"] for r in rows], dtype=float)
        plt.plot(z, y, marker="o", linewidth=2, label=f"{key}: Theorie - Real")

    plt.axhline(0.0, linewidth=1.2, linestyle="--")
    plt.xlabel("z [m]")
    plt.ylabel("Differenz [mm]")
    plt.title("Differenz zwischen Theorie und Realdaten")
    plt.grid(True, alpha=0.3)
    plt.legend()
    plt.tight_layout()

    out = output_dir / "theory_minus_real_plot.png"
    plt.savefig(out, dpi=220)
    plt.show()
    return out


def plot_theory_and_real_overlay(rows: list[dict[str, float]], keys: list[str], output_dir: Path) -> Path:
    z = np.array([r["z_m"] for r in rows], dtype=float)

    plt.figure(figsize=(12, 8))
    for key in keys:
        y_theory = np.array([r[f"{key}_theory"] for r in rows], dtype=float)
        y_real = np.array([r[f"{key}_real"] for r in rows], dtype=float)

        plt.plot(z, y_theory, marker="o", linewidth=2, label=f"{key} Theorie")
        plt.plot(z, y_real, marker="x", linewidth=1.5, linestyle="--", label=f"{key} Real")

    plt.xlabel("z [m]")
    plt.ylabel("Beam size [mm]")
    plt.title("Theorie und Realdaten im direkten Vergleich")
    plt.grid(True, alpha=0.3)
    plt.legend(ncol=2)
    plt.tight_layout()

    out = output_dir / "theory_and_real_overlay.png"
    plt.savefig(out, dpi=220)
    plt.close()
    return out


# ============================================================
# MAIN
# ============================================================

def main() -> None:
    output_dir = Path(CFG["OUTPUT_DIR"])
    output_dir.mkdir(parents=True, exist_ok=True)

    theory_rows = load_theory_csv(Path(CFG["THEORY_CSV"]))
    real_rows = load_real_data()

    keys = list(CFG["PLOT_KEYS"])

    if CFG["INTERPOLATE_THEORY_TO_REAL_Z"]:
        comparison_rows = interpolate_theory_to_real_z(theory_rows, real_rows, keys)
    else:
        comparison_rows = exact_match_theory_and_real(theory_rows, real_rows, keys)

    if not comparison_rows:
        raise SystemExit("Keine gemeinsamen Vergleichsdaten gefunden.")

    csv_path = save_comparison_csv(comparison_rows, output_dir)
    diff_plot_path = plot_difference(comparison_rows, keys, output_dir)
    overlay_plot_path = plot_theory_and_real_overlay(comparison_rows, keys, output_dir)

    print()
    print("=" * 80)
    print("VERGLEICH FERTIG")
    print("=" * 80)
    print(f"Realdaten-Skalierung:     {CFG['REAL_PX_PER_MM']} px/mm")
    print(f"Realdaten in mm:          1 px = {1.0 / float(CFG['REAL_PX_PER_MM']):.6f} mm")
    print(f"Vergleichs-CSV:           {csv_path}")
    print(f"Differenz-Plot:           {diff_plot_path}")
    print(f"Overlay-Plot:             {overlay_plot_path}")
    print()
    print("Differenz ist definiert als:")
    print("    Theorie - Real")
    print()
    if CFG["INTERPOLATE_THEORY_TO_REAL_Z"]:
        print("Die Theoriedaten wurden auf die realen z-Positionen interpoliert.")
    else:
        print("Es wurden nur exakt gleiche z-Positionen verwendet.")


if __name__ == "__main__":
    main()