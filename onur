def process_folder(folder_path):
    """Process all TIFF images in a folder and plot them in multiple figures."""
    images = []
    covariances = []
    centroids = []
    eigenvals = []
    file_names = []
    major_vals = []
    minor_vals = []
    for file_name in sorted(os.listdir(folder_path)):
        if file_name.lower().endswith('.tiff'):
            file_path = os.path.join(folder_path, file_name)
            image_array = load_tiff_image(file_path)
            covariance_matrix, centroid = compute_covariance_matrix(image_array)
            images.append(image_array)
            covariances.append(covariance_matrix)
            centroids.append(centroid)
            file_names.append(file_name)
    
    if images:
        plot_laser_spots_with_ellipses(images, covariances, centroids, file_names)

