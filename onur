    return image_array

def compute_covariance_matrix(image_array):
    """Compute the covariance matrix of the laser spot intensity distribution."""
    height, width = image_array.shape
    x = np.arange(width)*3.45*1e-3  #5.5*1e-3 ; 3.45*1e-3
    y = np.arange(height)*3.45*1e-3  #5.5*1e-3 ; 3.45*1e-3
    X, Y = np.meshgrid(x, y)
    
    intensity = image_array / np.sum(image_array)
    x_mean = np.sum(X * intensity)
    y_mean = np.sum(Y * intensity)
    
    cov_xx = np.sum(intensity * (X - x_mean) ** 2)
    cov_yy = np.sum(intensity * (Y - y_mean) ** 2)
    cov_xy = np.sum(intensity * (X - x_mean) * (Y - y_mean))
    
    covariance_matrix = np.array([[cov_xx, cov_xy], [cov_xy, cov_yy]])
    return covariance_matrix, (x_mean, y_mean)



